@inproceedings{Jespersen:2015,
  author    = {Jespersen, Thomas Bracht Laumann and Munksgaard, Philip and Larsen, Ken Friis},
  title     = {Session types for Rust},
  year      = {2015},
  isbn      = {9781450338103},
